# Copy to .env and fill in. Everything here is read by docker compose.
#
# Pin the version rather than tracking latest: the link to this site is slow and
# occasionally down, and a deploy should be a decision.
RATTLECAM_VERSION=1.1.0

# --- UniFi Protect -----------------------------------------------------------
# Console address, no scheme.
PROTECT_HOST=192.168.1.1
# UniFi console -> Integrations -> New API Key
PROTECT_API_KEY=
# The GUID in the Protect dashboard URL for this camera
PROTECT_CAMERA_ID=
# Hex SHA-256 of the console's leaf certificate. Leaving it unset skips TLS
# verification entirely, which is fine on a bench and less fine for something
# feeding a newsroom — a device swap on the LAN could silently substitute the
# image. Capture it with:
#   echo | openssl s_client -connect "$PROTECT_HOST:443" 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
PROTECT_CERT_SHA256=

# --- Weather -----------------------------------------------------------------
INFLUX_URL=http://192.168.1.10:8086
INFLUX_ORG=
INFLUX_TOKEN=
INFLUX_BUCKET=weather
# Tempest serial, e.g. ST-00000512. Unset means do not filter by station.
INFLUX_STATION=

# Nearest NWS reporting station, for the plain-language conditions line.
# Unset hides that line.
NWS_STATION_ID=
NWS_USER_AGENT=rattlecam (you@example.com)

# --- Site --------------------------------------------------------------------
SITE_NAME=Valley View
CREDIT=This view is provided by RSVU
# Metres, and not optional in practice. The station reports station pressure:
# at 899.65 mb this site publishes 29.94 in when set correctly and 26.57 in when
# left at zero — several inches below anything a local forecast shows, with no
# error to tell you.
SITE_ELEVATION_M=1000
TZ=America/Los_Angeles

# Width of the extra copy published for websites. The full frame is 4K for
# outlets; a browser does not need it, and 1280 is a sixth of the bytes. 0
# disables the copy.
WEB_WIDTH=1280

# --- Night -------------------------------------------------------------------
# Measured from each frame's mean luma, 0-255. Frames here run about 10 at night
# and over 100 in daylight, so these sit in the gap. They are a hysteresis band:
# the daemon refuses to start if EXIT is not above ENTER, because without a gap
# the state would flip on every poll through dusk.
#
# After dark the peak annotation is drawn inverted — white instead of black, so
# it stays visible against the sky. That is the only thing that changes: the live
# frame publishes on the same cadence and masters are archived at the same
# interval, day and night.
NIGHT_ENTER_LUMA=35
NIGHT_EXIT_LUMA=55
NIGHT_INVERT_ANNOTATION=true

# --- Object storage ----------------------------------------------------------
# tofu output -raw rattlecam_bucket
GCS_BUCKET=
GCS_ARCHIVE=true
# The queue that carries frames across a network outage. At ~1.1 MB a frame,
# 2 GiB is about 33 hours of backlog; past it the oldest archive frames are
# dropped and latest.jpg is kept.
SPOOL_MAX_BYTES=2147483648

# --- Timing ------------------------------------------------------------------
POLL_INTERVAL=15s
MIN_FRAME_GAP=55s
# Checked once per poll, so a value below POLL_INTERVAL cannot fire and will be
# clamped to it with a warning.
MAX_FRAME_AGE=3m
STALE_AFTER=10m

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
METRICS_EXPORTER=prometheus
METRICS_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=text
