# Fonts are OFL and travel with the repository, so a clean checkout renders and
# the image is self-contained. The artwork does not: the logo and the peak
# annotation are the agency's own, and a public repository is the wrong place
# for them. They are placed on the host by hand.
/assets/logo.png
/assets/annotation.png

# Preview harness output and source stills.
/out/
/testdata/

# Built binaries.
/preview
/rattlecam

# Local tooling.
/node_modules/

# Deployment secrets and per-host config. The examples are tracked; what you
# fill in is not.
/deploy/**/.env
/deploy/**/secrets/
