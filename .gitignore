# Fonts are OFL and travel with the repository, so a clean checkout renders and
# the image is self-contained. The artwork does not: the logo and the peak
# annotation are the agency's own, and a public repository is the wrong place
# for them. They are placed on the host by hand.
/assets/logo.png
/assets/annotation.png

# Preview harness output and source stills.
/out/
/testdata/

# Built binaries.
/preview
/rattlecam
/timelapse

# Local tooling.
/node_modules/

# Deployment secrets and per-host config. The examples are tracked; what you
# fill in is not.
/deploy/**/.env
/deploy/**/secrets/

# Terraform's provider cache, state and lock file. deploy/timelapse is a
# reference copy of a module that is applied from the infrastructure repository,
# never from here — so a lock file committed alongside it would pin provider
# hashes nothing in this repository verifies, go stale unnoticed, and suggest
# this is the configuration that actually runs. The real one is next to the real
# state.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
