# Branding, loaded from disk at runtime rather than embedded so it can change
# without a rebuild. The directory itself is tracked — its README documents what
# belongs here, and the Dockerfile's COPY needs it to exist in a clean checkout.
/assets/*
!/assets/README.md

# Preview harness output and source stills.
/out/
/testdata/

# Built binaries.
/preview
/rattlecam

# Local tooling.
/node_modules/

# Deployment secrets and per-host config. The examples are tracked; what you
# fill in is not.
/deploy/**/.env
/deploy/**/secrets/
